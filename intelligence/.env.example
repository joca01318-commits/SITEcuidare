# Porta e endereço do servidor
PORT=8787
HOST=0.0.0.0

# Pasta onde ficam o banco de dados, os arquivos importados e os backups.
# Faça backup externo desta pasta.
DATA_DIR=./data

# Em produção (HTTPS) deixe "true". Só use "false" para testar em http://localhost.
COOKIE_SECURE=true

# Endereço público do sistema (usado na verificação de origem das requisições)
APP_ORIGIN=https://intelligence.cuidare.com.br

# ---------------- Assistente de IA ----------------
# rules  → somente o motor próprio em português (custo zero, nada sai do servidor)
# hybrid → motor próprio primeiro; pedidos que ele não entende vão para o modelo configurado abaixo
# llm    → tudo vai para o modelo configurado (o motor próprio vira reserva)
AI_MODE=rules

# Qualquer provedor compatível com a API de chat da OpenAI:
#   Ollama local (gratuito, roda no seu servidor): AI_BASE_URL=http://127.0.0.1:11434/v1  AI_MODEL=qwen2.5:7b  AI_PROVIDER_LOCAL=true
#   Groq (camada gratuita com limites):            AI_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# true quando o modelo roda no próprio servidor (aí colunas sensíveis podem ser enviadas a ele)
AI_PROVIDER_LOCAL=false
